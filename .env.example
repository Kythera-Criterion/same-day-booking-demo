# Supabase の「Project Settings → API」の値を入れて、.env.local という名前で保存してください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側の処理（app/api 配下）とスクリプトだけで使います（画面側では使いません。公開しないでください）
SUPABASE_SERVICE_ROLE_KEY=

# デモ用ユーザーの共通パスワード（サーバー側のデモログインとスクリプトで使います）
DEMO_PASSWORD=demo-pass-2026

# true のときだけ /demo とデモ用の API（ワンタップログイン・リセットなど）が動きます。本番では false にしてください
DEMO_MODE=true

# 通知の定期実行（Vercel Cron などから Authorization: Bearer <この値> で呼びます）。長いランダムな文字列にしてください
CRON_SECRET=

# 任意：LINE Messaging API のチャネルアクセストークン（未設定ならシミュレーション送信）
LINE_CHANNEL_ACCESS_TOKEN=

# 任意：Resend の API キーと送信元（未設定ならシミュレーション送信）
RESEND_API_KEY=
MAIL_FROM=
# 任意：メールの返信先（運営事務局の問い合わせ先）
MAIL_REPLY_TO=

# 公開する URL（例：https://example.com）。サロンへのご利用開始のリンクに使う。未設定なら、承認したときに開いていた URL を使う
APP_URL=

# 任意：Google でのログイン（Google Cloud Console の OAuth クライアント ID）。リダイレクト URI は {APP_URL}/api/auth/callback/google
# 未設定なら、DEMO_MODE=true ではデモ用の認証画面で流れを試せ、本番ではボタンを出しません
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 任意：Yahoo! JAPAN ID でのログイン（Yahoo!デベロッパーネットワークの Client ID / シークレット）。リダイレクト URI は {APP_URL}/api/auth/callback/yahoo
YAHOO_JAPAN_CLIENT_ID=
YAHOO_JAPAN_CLIENT_SECRET=

# 任意：外部 ID の手続き中の情報に付ける署名の鍵（長いランダムな文字列）。未設定なら SUPABASE_SERVICE_ROLE_KEY から作ります
AUTH_FLOW_SECRET=
